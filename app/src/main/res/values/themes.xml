<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MemoryLane" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/coral_primary</item>
        <item name="colorPrimaryVariant">@color/coral_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/sage_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowBackground">@color/cream_bg</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/cream_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/cream_bg</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- App-wide default corner rounding for MaterialCardView/Button/etc -->
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.MemoryLane.Card</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.MemoryLane.Thumb</item>

        <!-- Smooth activity transitions (used for the shared-element "zoom into project" effect) -->
        <item name="android:windowActivityTransitions" tools:targetApi="lollipop">true</item>
        <item name="android:windowContentTransitions" tools:targetApi="lollipop">true</item>
    </style>

    <style name="Theme.MemoryLane.Toolbar" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar">
        <item name="android:textColorPrimary">@color/brown_text</item>
    </style>

</resources>
